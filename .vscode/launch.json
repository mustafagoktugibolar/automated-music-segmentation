{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "music-segmentation-debugger",
            "type": "debugpy",
            "request": "launch",
            "module": "backend.main",
            "env": {
                "APP_ENV": "dev"
            },
            "envFile": "${workspaceFolder}/.env.dev",
            "jinja": true,
            "justMyCode": true,
            "python": "/opt/miniconda3/envs/music-segmentation-env/bin/python"
        },
        {
            "name": "music-segmentation-debugger (Sync Data)",
            "type": "debugpy",
            "request": "launch",
            "module": "backend.main",
            "args": [
                "--sync-data"
            ],
            "env": {
                "APP_ENV": "dev"
            },
            "envFile": "${workspaceFolder}/.env.dev",
            "jinja": true,
            "justMyCode": true,
            "python": "/opt/miniconda3/envs/music-segmentation-env/bin/python"
        }
    ]
}