DB_HOST=music_segmentation_db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_secret_password
DB_NAME=music_segmentation_db

# Pooling settings (optional)
PG_MIN_CONN=1
PG_MAX_CONN=10
PG_RETRY_COUNT=5
PG_RETRY_WAIT=3
PG_STATEMENT_TIMEOUT_MS=15000

# Worker scaling
# Recommended start on 8 cores: 4 custom worker containers x concurrency 1.
# Raise to 2 only if CPU/RAM headroom remains, then set batch concurrency to 8.
CUSTOM_WORKER_REPLICAS=4
WORKER_CONCURRENCY=1
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# Blob Storage
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=...
AZURE_STORAGE_CONTAINER_RAW=songs-container

# S3 / MinIO (optional)
S3_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_RAW=songs
S3_REGION=us-east-1

# MinIO root credentials (used by docker-compose)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
